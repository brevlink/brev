{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Brev",
  "description": "Create and copy short links without leaving the page.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Brev",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}
  },
  "background": {"service_worker": "background.js", "type": "module"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "permissions": ["activeTab", "storage", "contextMenus", "clipboardWrite", "offscreen"],
  "host_permissions": ["https://brevl.ink/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "shorten-current-page": {
      "suggested_key": {"default": "Ctrl+Shift+Y"},
      "description": "Create and copy a short link for the current page"
    }
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
