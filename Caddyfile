# Brev Caddyfile
# Proxy: landing (default), /api/* -> backend, /app/* -> dashboard, /slug -> backend.
#
# Il routing sta in uno snippet perché serve su due porte:
#   :80  -> qui NPM inoltra brevl.ink e proxy.brevl.ink (percorso normale)
#   :443 -> gamba Cloudflare for SaaS (vedi in fondo)
{
	# Niente redirect automatici: il TLS lo fa NPM sul percorso normale e
	# Cloudflare sulla gamba SaaS. Caddy qui resta un router.
	auto_https disable_redirects
}

(routing) {
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /docs {
		reverse_proxy backend:8000
	}

	handle /redoc {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle_path /app/* {
		reverse_proxy dashboard:80
	}

	handle /app {
		redir /app/ 301
	}

	# Keep legal pages on the landing service, including their trailing-slash forms.
	@legal path /privacy /privacy/ /terms /terms/ /cookies /cookies/ /legal /legal/ /subprocessors /subprocessors/
	handle @legal {
		reverse_proxy landing:80
	}

	@short path_regexp short ^/[A-Za-z0-9_-]{3,64}$
	handle @short {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy landing:80
	}
}

:80 {
	import routing
}

# Cloudflare for SaaS.
#
# Cloudflare si connette su questa porta (pubblicata come 8443 sulla VPS, così
# la 443 dell'host resta a nginx-proxy-manager) con SNI = proxy.brevl.ink, il
# fallback origin, e Host = dominio del cliente. Il certificato lo prende caddy
# per il nome del fallback; le richieste dei clienti arrivano con un Host
# diverso e le serve il sito senza host qui sotto, che accetta qualunque nome.
#
# È per questo che questa gamba non passa da NPM: nginx considera errore una
# richiesta il cui Host non corrisponde allo SNI della connessione e risponde
# 421, caddy instrada per Host e non si formalizza.
proxy.brevl.ink:443 {
	import routing
}

:443 {
	import routing
}
