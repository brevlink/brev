# Brev Caddyfile
# Proxy: landing (default), /api/* -> backend, /app/* -> dashboard, /slug -> backend.
#
# The routing lives in a snippet because it is served on two ports:
#   :80  -> nginx-proxy-manager forwards brevl.ink and proxy.brevl.ink here
#   :443 -> the Cloudflare for SaaS leg (see the bottom of this file)
{
	# No automatic redirects: TLS is terminated by nginx-proxy-manager on the
	# normal path and by Cloudflare on the SaaS leg. Caddy here is a router.
	auto_https disable_redirects
}

(routing) {
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /docs {
		reverse_proxy backend:8000
	}

	handle /redoc {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle_path /app/* {
		reverse_proxy dashboard:80
	}

	handle /app {
		redir /app/ 301
	}

	# Keep legal pages on the landing service, including their trailing-slash forms.
	@legal path /privacy /privacy/ /terms /terms/ /cookies /cookies/ /legal /legal/ /subprocessors /subprocessors/
	handle @legal {
		reverse_proxy landing:80
	}

	@short path_regexp short ^/[A-Za-z0-9_-]{3,64}$
	handle @short {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy landing:80
	}
}

:80 {
	import routing
}

# Cloudflare for SaaS.
#
# Cloudflare connects to this port (published as 8443 on the host so that
# nginx-proxy-manager keeps 443) with SNI = proxy.brevl.ink, the fallback
# origin, and Host = the customer hostname. The two values differ, on purpose:
# the backend resolves the tenant from the Host.
#
# nginx treats that combination as an error — 421 over HTTP/2, a dropped
# connection over HTTP/1.1 — while Caddy routes by Host and does not care, which
# is the whole reason this leg does not go through nginx-proxy-manager.
#
# The certificate is a Cloudflare Origin CA certificate for the fallback origin,
# valid 15 years: Cloudflare verifies it in Full (strict) and it never needs
# renewing. Caddy serves it for any SNI, because only Cloudflare talks to this
# port. The files live in /data/certs on the host, outside the repository,
# because they are private material.
:443 {
	tls /data/certs/proxy.brevl.ink.crt /data/certs/proxy.brevl.ink.key
	import routing
}
